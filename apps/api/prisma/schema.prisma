// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator class_generator {
  provider = "prisma-class-generator"
  output   = "../src/modules-system/prisma/generated/prisma"
  dryRun   = "false"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Users {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  email        String       @unique
  fullName     String?
  avatar       String?
  phone        String?
  dateOfBirth  String?
  gender       String?
  bio          String?
  school       String?
  major        String?
  targetRole   String?
  address      String?
  passwordHash String?
  role         String?      @default("users")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  v            Int?         @map("__v")
  cvAnalyses   CvAnalysis[]

  @@map("users")
}

model CvAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?  @db.ObjectId
  user            Users?   @relation(fields: [userId], references: [id])
  cvFileName      String
  cvFileUrl       String?
  targetRole      String
  status          String   @default("BASELINE_CREATED")
  rawCvText       String?
  baselineResult  Json?
  questionsResult Json?
  answersResult   Json?
  evaluationResult Json?
  competencyScore Float?
  currentLevel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cv_analyses")
}

